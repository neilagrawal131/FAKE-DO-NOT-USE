# Copy this file to ".env" (same folder) and fill in your key:
#     cp .env.example .env
# then edit .env. The real .env is gitignored, so your key is never committed.

# ── Data source ───────────────────────────────────────────────────────────────
# Polygon.io API key — enables real quotes + deep history (needed for a real
# backtest). Without it the app falls back to Yahoo, and with DATA_SOURCE=mock it
# uses synthetic data (no network).
POLYGON_API_KEY=your_polygon_key_here

# How many days of 30-minute intraday history your Polygon plan allows.
POLYGON_INTRADAY_MAX_DAYS=730

# Force a data source (optional): polygon | yahoo | mock.
# With POLYGON_API_KEY set, the backend uses Polygon by default.
# DATA_SOURCE=polygon

# ── Trading-cost model (used by walk-forward + Factor Lab) ────────────────────
# Round-trip cost in basis points (1 bp = 0.01%). Defaults are tuned for liquid
# large-caps on a zero-commission broker. Raise these to stress-test an edge.
# COST_COMMISSION_BPS=1
# COST_SPREAD_BPS=4
# COST_SLIPPAGE_BPS=3

# ── Cash-account settlement ───────────────────────────────────────────────────
# Business days until sale proceeds settle (US equities are T+1). Set 0 to model
# a margin-style account with no settlement hold.
# SETTLE_BUSINESS_DAYS=1

# ── Autonomous Strategist out-of-sample gate (optional tuning) ────────────────
# STRATEGIST_OOS_MIN_TRADES=20
# STRATEGIST_VALIDATE_PER_CYCLE=3

# ── Broker (Phase 0 scaffold) ─────────────────────────────────────────────────
# paper (default) or ibkr (stub). See docs/GOING_LIVE.md.
# BROKER=paper
